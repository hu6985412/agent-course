# W05 环境变量示例（占位，绝不写真实 Key）
# 复制本文件为 .env 后填入，或在本机 PS 窗口用 start-env-windows.bat 注入

# 百炼（DashScope）OpenAI 兼容端点 + embedding Key
API_KEY=sk-xxx
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 说明：
# - EMB_MODEL 在 01_build_index.py 里写死为 qwen3.7-text-embedding-flash（1024 维）
# - 02_query.py 复用同一个 EMB_MODEL
# - MODEL 仅 chat 用，embedding 不需要，本目录脚本不读它
# - 中转站若支持 /embeddings 路由，也可把 BASE_URL 换回中转地址，其余不变
