# W04 实验环境变量模板（占位，绝不填真实 Key）
# 用法：复制为 .env 后填值；或直接使用仓库外的 start-env-windows.bat 注入（推荐）
# 注意：agent.py 直接从 os.environ 读取，**不自动解析 .env 文件**，
#       需由 shell 先 source / 注入，或手动 export（bash）/ $env:（PowerShell）。

# ---- 真实 LLM（OpenAI 兼容接口）----
API_KEY=sk-xxx
BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL=deepseek-v4-flash

# ---- 落库（agent_runtime 本地库，可选；连不上自动降级为不落库）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=agent_runtime

# ---- 死循环测试（可选）----
# 设为 1 时物流接口恒返回 500，用于验证防护④（重复调用检测）
W04_DEADLOOP=0
