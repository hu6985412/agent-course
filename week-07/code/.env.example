# 复制本文件为 .env 并填入你的配置（.env 不进 git，仅本地使用）
# 注意：本机真实 Key 一律只在终端环境变量里，绝不写进任何文件。

# —— LLM 网关（embedding 与生成都需要）——
API_KEY=sk-xxx
BASE_URL=https://your-llm-gateway.example/v1
MODEL=deepseek-v4-flash
GENERATE_MODEL=deepseek-v4-flash

# —— pgvector 连接 ——
# 起库（Docker，与课程其它周共用同一容器，按 database 名区分周次）：
#   docker run -d --name gp17 -e POSTGRES_PASSWORD=amber123 -p 5432:5432 pgvector/pgvector:pg17
#   docker exec -i gp17 psql -U postgres -c "CREATE DATABASE w07rag OWNER postgres;"
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=w07rag
PG_USER=postgres
PG_PASSWORD=amber123
