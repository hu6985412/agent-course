# 复制本文件为 .env 并填写（真实 Key 只在终端环境变量里，不进文件）
# ⚠️ 占位 sk-xxx 不要提交真实 Key；本 .example 只用于说明需要哪些变量

# ---- LLM（OpenAI 兼容协议，chat 场景专用）----
API_KEY=sk-xxx
BASE_URL=https://your-gateway/v1
CHAT_MODEL=deepseek-v4-flash          # 对话/推理/工具调用；与 EMBEDDING_MODEL 区分开

# ---- pgvector（PostgresSaver 持久化，接本机 pgvector 容器，库 w08lg）----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=w08lg
PG_USER=amber
PG_PASSWORD=amber123
