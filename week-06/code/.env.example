# 百炼 embedding（与 W05 同款接入层）
API_KEY=your-bailian-key
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.7-text-embedding-flash

# pgvector 连接（复用本机 gp17 容器；amber 用户默认密码 amber123，如不同请改 PG_PASSWORD）
# 后续课程只改 PG_DB=w07rag 即可，其余保持
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=w06rag
PG_USER=amber
PG_PASSWORD=amber123
# PG_ADMIN 可选：建库用的超级用户，默认同 PG_USER(=amber)。若你的 gp17 超级用户是 postgres，请设 PG_ADMIN=postgres

# 可选：本地 cross-encoder 重排（需 pip install sentence-transformers，首次会下载模型）
# RERANKER=cross
