# 复制本文件为 .env 后填入真实值，.env 已被 .gitignore 忽略，切勿提交
# cp .env.example .env

# ---------- 主力模型：DeepSeek ----------
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_FLASH=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# ---------- 备用 / 对照模型 ----------
# 智谱 GLM：Agent 与工具调用更稳
GLM_API_KEY=
# 月之暗面 Kimi
KIMI_API_KEY=
# OpenAI：只用于国产 vs 海外的成本效果对照实验
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- 本地 / 开源模型 ----------
# W5 起用，Ollama 或 vLLM 起本地 embedding
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# ---------- 数据库 ----------
# W5 起：pgvector
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=agent_course
PG_USER=postgres
PG_PASSWORD=postgres

# 已有 MySQL 8（wamp64），W9 起 PHP/Laravel 侧使用
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agent_course
MYSQL_USER=root
MYSQL_PASSWORD=

# ---------- 可观测（W14）----------
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 数据源（W6）----------
TUSHARE_TOKEN=

# ---------- 成本护栏 ----------
# 单次实验的软上限，超过就中断，防止循环失控烧钱
MAX_COST_PER_RUN_USD=2.0
